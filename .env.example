# ── LLM Chat Provider ─────────────────────────────────────────────────────────
# Options: claude | azure_openai | openai
LLM_PROVIDER=claude

# Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI (used when LLM_PROVIDER=azure_openai, or as embedding provider)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# OpenAI (used when LLM_PROVIDER=openai, or as embedding provider)
OPENAI_API_KEY=

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: azure_openai | openai
# Note: Claude has no embeddings API; always set this independently of LLM_PROVIDER
EMBEDDING_PROVIDER=openai

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://docusense:docusense@localhost:5432/docusense
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Agent Tuning ──────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=5
RELEVANCE_THRESHOLD=0.6
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_CHAT_MODEL=gpt-4o

# ── Dev Flags ─────────────────────────────────────────────────────────────────
# Set to true to bypass all LLM calls with canned responses (no API key needed)
USE_MOCK_LLM=false

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL controls the backend.* logger. Root logger is always WARNING (no
# third-party noise). Recommended: DEBUG locally, INFO in Docker/demo.
LOG_LEVEL=DEBUG        # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=plain       # plain (human-readable) | json (machine-readable / log aggregators)

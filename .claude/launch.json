{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Vite via Docker)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build", "frontend"],
      "port": 3001
    },
    {
      "name": "Backend (Uvicorn via Docker)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "backend"],
      "port": 8080
    },
    {
      "name": "Full Stack (Docker Compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up"],
      "port": 3001
    },
    {
      "name": "Frontend (local npm)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "Backend (local uvicorn)",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["backend.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"],
      "port": 8080
    }
  ]
}
